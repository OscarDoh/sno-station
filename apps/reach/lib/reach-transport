#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# == 1 && "$1" == --help ]]; then
    printf 'usage: reach-transport for-kind <kind>\n'
    exit 0
fi
if [[ $# != 2 || "$1" != for-kind || ! "$2" =~ ^[a-z][a-z0-9-]*$ ]]; then
    printf 'reach-transport: usage: for-kind <kind>\n' >&2
    exit 64
fi
readonly CONFIG="$HOME/.config/sno-reach/agents.json"
[[ -e "$CONFIG" || -L "$CONFIG" ]] || exit 0
if ! jq -e '
    type == "object" and all(to_entries[];
        (.key | test("^[a-z][a-z0-9-]*$")) and
        (.value | type == "object" and keys == ["acpx_agent"]) and
        (.value.acpx_agent | type == "string" and test("^[a-zA-Z0-9][a-zA-Z0-9_-]*$")))
' "$CONFIG" >/dev/null 2>&1; then
    printf 'reach-transport: malformed routing config: %s; repair it before spawning\n' "$CONFIG" >&2
    exit 65
fi
jq -r --arg kind "$2" '.[$kind].acpx_agent // empty' "$CONFIG"
