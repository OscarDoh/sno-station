# Build outputs not caught by graphify's builtin _SKIP_DIRS
# (builtin already excludes: dist, build, target, out, node_modules,
#  .next, .nuxt, .turbo, .angular, .cache, .parcel-cache, .svelte-kit,
#  coverage, lcov-report, .pytest_cache, .mypy_cache, .ruff_cache,
#  __snapshots__, snapshots, storybook-static, dist-protected,
#  graphify-out, .graphify, venv/.venv, __pycache__, .git)
dist-e2e/
dist-test/
dist-cjs/
dist-esm/
.tsbuildinfo
*.tsbuildinfo

# Bundled/minified JS (defensive — bundles slip past dist/ when emitted at root)
*.bundle.js
*.min.js
*.min.css
*.map
*.js.map
*.d.ts.map

# Lock/manifest files (huge JSON, no structural value)
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb

# Runtime / logs
logs/
*.log

# VM / deployment state (mem-claw, openclaw)
.openclaw-vm-state/
.openclaw-vm/
deploy-bundle/
*.tgz
*.tar.gz
*.zip

# Eval run outputs (large JSONL traces, not architecture)
evals/runs/
evals/output/
evals/results/
eval-output/
**/eval-runs/

# Temp/scratch
tmp/
temp/
.tmp/
scratch/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Vendored / generated code (regenerate, never edit)
**/__generated__/
**/generated/
**/proto-gen/
