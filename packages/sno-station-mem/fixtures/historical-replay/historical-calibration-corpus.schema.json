{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sno.ai/schemas/rem/historical-calibration-corpus.schema.json",
  "title": "REM Historical Calibration Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusSnapshotSha256",
    "embeddingSnapshotSha256",
    "rankingConfigSha256",
    "targetPairs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "embeddingSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "rankingConfigSha256": { "$ref": "#/$defs/sha256" },
    "targetPairs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/targetPair" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowId", "text", "validTime"],
      "properties": {
        "rowId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "validTime": { "type": "string", "format": "date-time" }
      }
    },
    "targetPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationId",
        "older",
        "newer",
        "candidateRank",
        "similarityScore"
      ],
      "properties": {
        "relationId": { "type": "string", "minLength": 1 },
        "older": { "$ref": "#/$defs/row" },
        "newer": { "$ref": "#/$defs/row" },
        "candidateRank": { "type": "integer", "minimum": 1 },
        "similarityScore": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
