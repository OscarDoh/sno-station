{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sno.ai/schemas/live-clause-verdict-attestation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "artifact_sha256",
    "prompt_sha256",
    "model_config_sha256",
    "judge_implementation_sha256",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "result": { "enum": ["pass", "fail"] },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "model_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "judge_implementation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evaluated_at": { "type": "string", "format": "date-time" }
  }
}
