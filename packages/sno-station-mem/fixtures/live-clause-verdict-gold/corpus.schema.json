{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sno.ai/schemas/live-clause-verdict-gold-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "case_class", "section_name", "clauses", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "case_class": {
            "enum": [
              "ordinary-replacement",
              "pure-retraction",
              "no-op",
              "tombstone",
              "surface-similarity-no-retirement"
            ]
          },
          "section_name": { "type": "string", "minLength": 1 },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["origin", "value"],
              "properties": {
                "origin": { "enum": ["stored", "incoming"] },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "retired_clauses"],
            "properties": {
              "verdict": { "enum": ["merge", "tombstone", "no-op"] },
              "retired_clauses": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
